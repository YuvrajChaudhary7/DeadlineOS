JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ENVIRONMENT=development
DATABASE_URL=sqlite:///deadlineos.db
SEED_DEMO=true
PORT=5000
MAX_USER_STORAGE_BYTES=209715200
MAX_USER_FILES=100
# Optional ClamAV service. Set CLAMAV_REQUIRED=true in deployments that require scanning.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
LOGIN_EMAIL_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=30
LOGIN_WINDOW_MINUTES=15
ENABLE_REMINDERS=true
